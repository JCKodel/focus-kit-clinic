{
  "name": "focus-kit-clinic",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server/main.server.ts & vite",
    "server": "node src/server/main.server.ts",
    "setup": "node src/server/setup.server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vite build",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
